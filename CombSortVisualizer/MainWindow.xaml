<Window x:Class="CombSortVisualizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Comb Sort Visualizer" Height="450" Width="900"
        Background="#050814"
        FontWeight="Bold">
    <Grid Margin="10" Background="#050814">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Область визуализации -->
        <Border Grid.Row="0"
                BorderThickness="1"
                BorderBrush="#324776"
                Margin="0,0,0,8"
                Background="#050814">
            <Image x:Name="Img" Stretch="Fill"/>
        </Border>

        <!-- Панель управления -->
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Background="#08112A"
                    VerticalAlignment="Center">
            <TextBlock Text="N:"
                       VerticalAlignment="Center"
                       Margin="4,0,4,0"
                       Foreground="White"/>
            <TextBox x:Name="SizeBox"
                     Width="50"
                     Text="40"
                     Margin="0,0,8,0"
                     Background="#0F1B3A"
                     Foreground="White"
                     BorderBrush="#324776"
                     TextAlignment="Center"
                     VerticalContentAlignment="Center"/>

            <Button Content="Generate"
                    Width="80"
                    Margin="0,0,8,0"
                    Click="BtnGenerate_Click"
                    Background="#1A2A55"
                    Foreground="White"
                    BorderBrush="#3B5392"/>
            <Button Content="Start"
                    Width="70"
                    Margin="0,0,8,0"
                    Click="BtnStart_Click"
                    Background="#1A2A55"
                    Foreground="White"
                    BorderBrush="#3B5392"/>
            <Button Content="Pause"
                    Width="70"
                    Margin="0,0,8,0"
                    Click="BtnPause_Click"
                    Background="#1A2A55"
                    Foreground="White"
                    BorderBrush="#3B5392"/>
            <Button Content="Step"
                    Width="70"
                    Margin="0,0,8,0"
                    Click="BtnStep_Click"
                    Background="#1A2A55"
                    Foreground="White"
                    BorderBrush="#3B5392"/>
            <Button Content="Reset"
                    Width="70"
                    Margin="0,0,15,0"
                    Click="BtnReset_Click"
                    Background="#1A2A55"
                    Foreground="White"
                    BorderBrush="#3B5392"/>

            <TextBlock Text="Speed:"
                       VerticalAlignment="Center"
                       Margin="0,0,4,0"
                       Foreground="White"/>
            <Slider x:Name="SpeedSlider"
                    Width="140"
                    Minimum="0"
                    Maximum="1"
                    Value="0.5"
                    Margin="0,0,15,0"
                    Background="#0F1B3A"
                    VerticalAlignment="Center"/>

            <Label x:Name="LblMetrics"
                   VerticalAlignment="Center"
                   Foreground="White"
                   MinWidth="360"
                   Margin="10,0,0,0"
                   HorizontalContentAlignment="Left"/>
        </StackPanel>
    </Grid>
</Window>